---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const researchReports = (await getCollection("research"))
  .filter((report) => report.data.project === "gta-v-lspdfr")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="GTA V Legacy / LSPDFR | Linux Mod Lab"
  description="Linux Mod Lab research into GTA V Legacy, RAGE Plugin Hook, and LSPDFR compatibility on Linux."
>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="label">GAME COMPATIBILITY RESEARCH</span>
        <h1>GTA V Legacy / LSPDFR<span>.</span></h1>
        <p>
          Investigating the challenges of running GTA V Legacy,
          RAGE Plugin Hook, and LSPDFR through Linux compatibility layers.
        </p>
      </div>

      <article class="project-card">
        <div class="project-top">
          <span class="project-category">COMPATIBILITY RESEARCH</span>
          <span class="status">● ACTIVE RESEARCH</span>
        </div>

        <h2>Project Overview</h2>
        <p>
          This project investigates compatibility, plugin initialization,
          audio behavior, and runtime stability using Proton and Wine.
        </p>

        <p>
          Our goal is to document reproducible findings, identify
          compatibility barriers, and explore potential open-source
          solutions.
        </p>

        <div class="project-tags">
          <span>Gentoo</span>
          <span>Proton</span>
          <span>Wine</span>
          <span>LSPDFR</span>
        </div>
            </article>

      {researchReports.length > 0 && (
        <div class="research-section">
          <h2>Research Reports</h2>

          {researchReports.map((report) => (
            <article class="project-card">
              <div class="project-top">
                <span class="project-category">TECHNICAL RESEARCH</span>
                <span class="status">
                  {report.data.status.toUpperCase()}
                </span>
              </div>

              <h3>
                <a href={`/research/${report.id}/`}>
                  {report.data.title}
                </a>
              </h3>

              <p>{report.data.description}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>