---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteName = "Linux Mod Lab";
---

<BaseLayout title={`${siteName} | Open-Source Game Modding`}>
      <section class="hero">
        <div class="container">
          <div class="eyebrow">OPEN SOURCE • LINUX • GAME MODDING</div>

          <h1>
            Breaking<br />
            <span>compatibility barriers.</span>
          </h1>

          <p>
            Exploring what's possible when Linux gaming,
            modding, and open-source development come together.
          </p>

          <a class="button" href="/projects">Explore Our Projects →</a>
        </div>
      </section>

      <section id="projects" class="section">
        <div class="container">
          <div class="section-heading">
            <span class="label">OUR WORK</span>
            <h2>Featured Projects</h2>
          </div>

          <article class="project-card">
            <div class="project-top">
              <span class="project-category">GAME COMPATIBILITY</span>
              <span class="status">● ACTIVE RESEARCH</span>
            </div>

            <h3>GTA V Legacy / LSPDFR on Linux</h3>

            <p>
              Investigating RAGE Plugin Hook, LSPDFR, Proton,
              DirectSound, and Windows compatibility layers
              to make advanced GTA V modding possible on Linux.
            </p>

            <div class="project-tags">
              <span>Gentoo</span>
              <span>Proton</span>
              <span>Wine</span>
              <span>LSPDFR</span>
            </div>
          </article>
        </div>
      </section>

      <section id="about" class="section about-section">
        <div class="container">
          <span class="label">OUR MISSION</span>
          <h2>Built for the Linux community.</h2>

          <p>
            Linux Mod Lab is an independent project dedicated to
            exploring game modifications, documenting compatibility
            challenges, and sharing reproducible solutions.
          </p>

          <p>
            Starting with Gentoo Linux, our research aims to help
            users across distributions collaborate, experiment,
            and push Linux gaming forward.
          </p>
        </div>
      </section>

      <section id="community" class="section community-section">
        <div class="container">
          <span class="label">GET INVOLVED</span>
          <h2>Research is better together.</h2>

          <p>
            Developers, Linux enthusiasts, and modders are welcome.
            Linux Mod Lab is just getting started.
          </p>
        </div>
      </section>

</BaseLayout>
